# Másold .env néven, vagy futtasd a scripts/init-env.sh-t, amely a titkokat is legenerálja.
# A jelszavak csak URL-biztos karaktereket tartalmazhatnak, mert a kapcsolati URL-be kerülnek.

# Postgres
POSTGRES_PASSWORD=
FINANCE_OWNER_PASSWORD=
APP_WRITER_PASSWORD=
DBT_RUNNER_PASSWORD=
MB_READER_PASSWORD=
METABASE_DB_PASSWORD=

# Metabase: a kulcsot a jelszókezelőbe is mentsd el, nélküle költözés után
# a mentett adatbázis-kapcsolatok nem olvashatók.
MB_ENCRYPTION_SECRET_KEY=

# Garage: a kulcs formátuma GK + 24 hex, a titoké 64 hex
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# Mentés: a jelszót a jelszókezelőbe is mentsd el, nélküle a mentés használhatatlan.
RESTIC_PASSWORD=

# Worker: ezzel a tokennel éri el a postaládát
WORKER_API_TOKEN=

# Modell és feldolgozás: üresen az alapértékek érvényesek
# OLLAMA_MODEL: a képfelismerő modell (alap: glm-ocr)
# OLLAMA_NUM_THREAD: a modell szálainak száma (alap: 10)
# WORKER_POLL_SECONDS: ennyi másodpercenként néz rá a worker a postaládára (alap: 60)
OLLAMA_MODEL=
OLLAMA_NUM_THREAD=
WORKER_POLL_SECONDS=

# Háztartás: a két személy kódja vesszővel elválasztva
# (alap: person_a,person_b)
HOUSEHOLD_MEMBERS=

# Metabase felhasználók, a scripts/metabase-setup.sh használja
MB_ADMIN_FIRST_NAME=
MB_ADMIN_LAST_NAME=
MB_ADMIN_EMAIL=
MB_ADMIN_PASSWORD=
MB_SECOND_FIRST_NAME=
MB_SECOND_LAST_NAME=
MB_SECOND_EMAIL=
MB_SECOND_PASSWORD=

# Elhelyezés: üresen a home/ alatti alapértékek érvényesek
# DATA_DIR: a stack minden adata (alap: ./data)
# BACKUP_DIR: dumpok és a Garage tükre (alap: ./backup)
# RESTIC_REPO_DIR: a restic tároló, éles használatra külső meghajtó (alap: ./backup/restic)
# BIND_ADDRESS: erre a címre nyílnak a portok, lehet a gép Tailscale-címe (alap: 127.0.0.1)
# STATUS_URL: ide küldi a jelentést a status-report.sh (alap: a helyi webapp)
DATA_DIR=
BACKUP_DIR=
RESTIC_REPO_DIR=
BIND_ADDRESS=
STATUS_URL=
WEBAPP_PORT=
METABASE_PORT=
POSTGRES_PORT=
GARAGE_S3_PORT=
