# Másold .env néven, vagy futtasd a scripts/init-env.sh-t, amely a titkokat is legenerálja.
# A jelszavak csak URL-biztos karaktereket tartalmazhatnak, mert a kapcsolati URL-be kerülnek.

# Postgres
POSTGRES_PASSWORD=
FINANCE_OWNER_PASSWORD=
APP_WRITER_PASSWORD=
DBT_RUNNER_PASSWORD=
REPORT_READER_PASSWORD=

# Garage: a kulcs formátuma GK + 24 hex, a titoké 64 hex
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# Mentés: a jelszót a jelszókezelőbe is mentsd el, nélküle a mentés használhatatlan.
RESTIC_PASSWORD=

# Worker: ezzel a tokennel éri el a postaládát
WORKER_API_TOKEN=

# Modell és feldolgozás: üresen az alapértékek érvényesek
# OLLAMA_MODEL: a képfelismerő modell (alap: glm-ocr)
# OLLAMA_NUM_THREAD: a modell CPU-szálainak száma (alap: 10, GPU-val 1)
# WORKER_POLL_SECONDS: ennyi másodpercenként néz rá a worker a postaládára (alap: 60)
# OLLAMA_KEEP_ALIVE: meddig marad betöltve a modell, pl. 10m (alap: 0, GPU-val 10m)
# OLLAMA_MAX_SIDE: a kép hosszabb oldala pixelben (alap: 1400, GPU-val 2000)
OLLAMA_MODEL=
OLLAMA_NUM_THREAD=
WORKER_POLL_SECONDS=
OLLAMA_KEEP_ALIVE=
OLLAMA_MAX_SIDE=

# Háztartás: a két személy kódja vesszővel elválasztva
# (alap: person_a,person_b)
HOUSEHOLD_MEMBERS=

# Elhelyezés: üresen a home/ alatti alapértékek érvényesek
# DATA_DIR: a stack minden adata (alap: ./data)
# BACKUP_DIR: dumpok és a Garage tükre (alap: ./backup)
# RESTIC_REPO_DIR: a restic tároló, éles használatra külső meghajtó (alap: ./backup/restic)
# COMPOSE_FILE: a Compose-fájlok, a docker-compose.yml után a kiegészítések:
#   :docker-compose.inbox.yml helyi postaláda Pi nélkül (ez az alap, a Pi-vel kimarad),
#   :docker-compose.gpu.yml NVIDIA GPU (lásd scripts/setup-wsl-gpu.sh),
#   :docker-compose.tailnet.yml riportok a Tailscale-címen is
# TAILNET_ADDRESS: a gép Tailscale-címe, ezen is látszanak a riportok (csak a tailnet kiegészítéssel)
# BIND_ADDRESS: erre a címre nyílnak a portok, lehet a gép Tailscale-címe (alap: 127.0.0.1)
# INBOX_URL: a postaláda, kötelező: helyi postaládánál http://webapp:8000, a Pi-vel a Pi
#   https-címe (README, „Postaláda a Pi-n”)
# STATUS_URL: ide küldi a jelentést a status-report.sh; a Pi-vel ugyanaz, mint az INBOX_URL
#   (alap: a helyi webapp)
# PI_BACKUP_TARGET: a Pi mentő felhasználója, pl. mentes@<a Pi Tailscale-címe>; üresen nincs Pi-mentés
# PI_BACKUP_KEY: a mentőkulcs (alap: ~/.ssh/finance_pi_backup)
PI_BACKUP_TARGET=
PI_BACKUP_KEY=
COMPOSE_FILE=docker-compose.yml:docker-compose.inbox.yml
INBOX_URL=http://webapp:8000
DATA_DIR=
BACKUP_DIR=
RESTIC_REPO_DIR=
BIND_ADDRESS=
STATUS_URL=
WEBAPP_PORT=
REPORTS_PORT=
POSTGRES_PORT=
GARAGE_S3_PORT=
