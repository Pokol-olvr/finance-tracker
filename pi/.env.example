# A Pi beállításai. Másold .env néven, vagy futtasd a scripts/init-pi-env.sh-t, amely a titkokat is legenerálja.

# A webapp címe a saját domainen, pl. penzugy.example.hu; a belépés az auth. aldomainen lesz.
# Mindkét név a Pi-hole helyi rekordja a Pi Tailscale-címére; a nyilvános DNS-ben nincs rekord.
FINANCE_DOMAIN=
# Cloudflare API-token csak ehhez a zónához, Zone.DNS szerkesztési joggal.
CLOUDFLARE_API_TOKEN=
# A Pi Tailscale-címe (tailscale ip -4); a portok csak ezen nyílnak.
BIND_ADDRESS=

# Az otthoni stackkel közös token, a home/.env WORKER_API_TOKEN értéke.
WORKER_API_TOKEN=
# A két személy kódja, ugyanaz, mint a home/.env-ben; az Authelia felhasználónevei is ezek.
HOUSEHOLD_MEMBERS=
# Az otthoni gép riportjai a tailneten, pl. http://<otthoni gép Tailscale-címe>:8501
REPORTS_URL=

# Authelia titkok
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=

# Elhelyezés: üresen a pi/ alatti data mappa
DATA_DIR=
